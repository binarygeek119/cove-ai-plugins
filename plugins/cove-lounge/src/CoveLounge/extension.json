{
  "id": "com.binarygeek119.cove-lounge",
  "name": "CoveLounge QuickPin",
  "version": "0.1.5",
  "description": "Connect CoveLounge apps to this Cove server using the quick PIN relay. Pairing now issues a real Cove API key so the app can reach Cove's stream, metadata, engagement, thumbnail, and health endpoints.",
  "author": "binarygeek119",
  "url": "https://github.com/binarygeek119/cove-ai-plugins",
  "kind": "extension",
  "categories": ["integration", "tools"],
  "minCoveVersion": "1.4.0",
  "entryDll": "CoveLounge.dll",
  "jsBundle": "assets/ui.mjs",
  "permissions": {
    "network": ["covelounge.duckdns.org", "*.covelounge.duckdns.org"]
  },
  "settings": [
    {
      "name": "covePublicUrl",
      "type": "STRING",
      "displayName": "Cove public URL",
      "description": "Internet-reachable Cove URL."
    },
    {
      "name": "coveInternalUrl",
      "type": "STRING",
      "displayName": "Cove internal URL",
      "description": "LAN/internal Cove URL."
    }
  ]
}
