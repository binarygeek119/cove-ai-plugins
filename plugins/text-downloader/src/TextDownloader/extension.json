{
  "id": "com.binarygeek119.text-downloader",
  "name": "Text Downloader",
  "version": "0.1.4",
  "description": "Downloads text stories from additional sites. Add new sites by extending TextDownloaderExtension.",
  "author": "binarygeek119",
  "url": "https://github.com/binarygeek119/cove-ai-plugins",
  "kind": "extension",
  "categories": [
    "downloader",
    "text"
  ],
  "minCoveVersion": "1.4.0",
  "entryDll": "TextDownloader.dll",
  "permissions": {
    "network": [
      "daddyforbaby.blogspot.com",
      "*.daddyforbaby.blogspot.com",
      "beltedgirls.com",
      "*.beltedgirls.com",
      "newsexstory.com",
      "*.newsexstory.com",
      "gaydemon.com",
      "*.gaydemon.com",
      "deviantart.com",
      "*.deviantart.com",
      "storiesonline.net",
      "*.storiesonline.net",
      "asstr-mirror.org",
      "*.asstr-mirror.org",
      "nifty.org",
      "*.nifty.org"
    ]
  }
}